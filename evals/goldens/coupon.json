      "patterns": ["(同时|混合).{0,30}未兑换.{0,15}已兑换.{0,70}未兑换.{0,20}删除.{0,35}已兑换.{0,20}保留", "未兑换.{0,20}删除.{0,50}已兑换.{0,20}(保留|仍存在)"]
