{
  "caseId": "coupon-001",
  "coreFacts": [
    {
      "id": "F01",
      "description": "当前告警配置为是时不考虑批次是否有效会持续告警",
      "weight": 1,
      "patterns": [
        "告警配置.{0,12}[“\"']?是.{0,45}(不管|无论).{0,30}(有效|状态).{0,30}告警",
        "只要.{0,12}告警配置.{0,12}[“\"']?是.{0,50}一直告警"
      ]
    },
    {
      "id": "F02",
      "description": "批次无效时不再告警",
      "weight": 3,
      "patterns": [
        "无效.{0,35}(不再|不应|停止).{0,12}告警",
        "(不再|不应|停止).{0,12}告警.{0,35}无效"
      ]
    },
    {
      "id": "F03",
      "description": "当前时间超过截止时间时不再告警",
      "weight": 3,
      "patterns": [
        "(已过|超过|晚于).{0,20}截止时间.{0,30}(不再|不应|停止).{0,12}告警",
        "(不再|不应|停止).{0,12}告警.{0,30}(已过|超过|晚于).{0,20}截止时间"
      ]
    },
    {
      "id": "F04",
      "description": "当前删除多码批次时底表兑换码没有同步删除",
      "weight": 1,
      "patterns": [
        "(当前|现状|当前表现).{0,45}(删除|清理).{0,35}多码.{0,70}(没有|未).{0,20}同步删除",
        "多码批次.{0,30}删除.{0,55}兑换码.{0,20}(没有|未).{0,15}同步删除"
      ]
    },
    {
      "id": "F05",
      "description": "删除多码批次时同步删除对应批次未兑换兑换码",
      "weight": 3,
      "patterns": [
        "删除.{0,35}多码批次.{0,70}(未兑换|还没有被兑换).{0,25}兑换码.{0,25}(同步删除|删除|清理)",
        "多码批次.{0,25}(同步删除|删除|清理).{0,55}(未兑换|还没有被兑换).{0,15}兑换码",
        "(未兑换|还没有被兑换).{0,25}兑换码.{0,30}(同步删除|删除|清理)"
      ]
    }
  ],
  "forbiddenClaims": [
    {
      "id": "H01",
      "description": "把上线确定等同于有效",
      "patterns": ["上线.{0,8}(就是|等于|即为).{0,8}有效", "有效.{0,8}(就是|等于|即为).{0,8}上线"]
    },
    {
      "id": "H02",
      "description": "把状态0确定为未兑换",
      "patterns": ["状态.{0,5}0.{0,8}(就是|表示|等于|即为).{0,8}未兑换", "未兑换.{0,8}(就是|表示|等于|即为).{0,8}状态.{0,5}0"]
    },
    {
      "id": "H03",
      "description": "要求删除全部兑换码",
      "patterns": ["删除.{0,18}(全部|所有)(?!未兑换|尚未兑换|还没有被兑换).{0,10}兑换码"]
    },
    {
      "id": "H04",
      "description": "把整体事务回滚写成已确定需求",
      "patterns": ["必须.{0,15}(整体回滚|事务回滚)", "明确要求.{0,15}(整体回滚|事务回滚)"]
    },
    {
      "id": "H05",
      "description": "把二次确认权限日志写成已确定需求",
      "patterns": ["PRD.{0,8}(明确|要求).{0,20}(二次确认|权限|操作日志)"]
    }
  ],
  "requiredClarifications": [
    {
      "id": "Q01",
      "description": "当前时间等于截止时间的边界",
      "patterns": ["(等于|刚好到达).{0,15}截止时间", "截止时间.{0,15}(等于|边界)"]
    },
    {
      "id": "Q02",
      "description": "有效无效与截图上线状态映射",
      "patterns": ["(有效|无效).{0,25}(上线|状态|枚举).{0,25}(映射|对应|定义)", "上线.{0,25}(有效|无效).{0,25}(映射|对应|含义)"]
    },
    {
      "id": "Q03",
      "description": "未兑换已兑换状态字段和枚举",
      "patterns": ["(未兑换|已兑换).{0,30}(字段|状态值|枚举|判定)", "(字段|状态值|枚举).{0,30}(未兑换|已兑换)"]
    },
    {
      "id": "Q04",
      "description": "批次删除与底表清理失败一致性策略",
      "patterns": ["(删除|清理).{0,30}(失败|异常).{0,30}(回滚|一致性|重试|幂等)", "(事务|回滚|一致性).{0,35}(删除|清理)"]
    }
  ],
  "coverageUnits": [
    {
      "id": "A01",
      "description": "告警开启有效未过期时告警",
      "weight": 3,
      "patterns": ["告警.{0,40}(是|开启).{0,80}有效.{0,80}(未到|早于|未过).{0,30}截止时间.{0,80}(触发|产生|继续).{0,15}告警"]
    },
    {
      "id": "A02",
      "description": "无效批次不告警",
      "weight": 3,
      "patterns": ["无效.{0,40}(不再|不应|不产生|停止).{0,12}告警"]
    },
    {
      "id": "A03",
      "description": "有效但已过期不告警",
      "weight": 3,
      "patterns": ["有效.{0,45}(已过|超过|晚于).{0,20}截止时间.{0,35}(不再|不应|不产生|过滤).{0,12}告警"]
    },
    {
