{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "caseIds", "evidence", "reason"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["covered", "partial", "missing"]
          },
          "caseIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
